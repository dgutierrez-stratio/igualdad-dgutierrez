#!/usr/bin/env bash
# gh FALSO: registra la llamada. `gh auth status` (falla con MOCK_GH_NOAUTH=1) y `gh api ...` (stdout = MOCK_UNIVERSE_LST).
# MOCK_GH_FAIL=1 -> exit 1; MOCK_GH_EMPTY=1 -> salida vacia; MOCK_GH_NOLOADER=1 -> lista sin connectors-loader.
echo "gh $*" >> "${MOCK_LOG:?}"
case "${1:-}" in
  auth) [[ "${MOCK_GH_NOAUTH:-0}" != 1 ]] || { echo "You are not logged into any GitHub hosts" >&2; exit 1; }; exit 0 ;;
  api)
    [[ "${MOCK_GH_FAIL:-0}" != 1 ]] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
    if [[ "${MOCK_GH_EMPTY:-0}" == 1 ]]; then exit 0
    elif [[ "${MOCK_GH_NOLOADER:-0}" == 1 ]]; then echo "qa.int.stratio.com/stratio/otra-imagen:1.0.0"
    else cat "${MOCK_UNIVERSE_LST:?}"; fi ;;
esac
exit 0
