# kit.env.example - variables propias del 2-apps-layer-kit. Copiar a kit.env y descomentar lo que se quiera cambiar.
# Prioridad: variables ya exportadas en el shell > kit.env > ../cluster.env > defaults de abajo.
# SIN SECRETOS: LLM_TOKEN y las claves S3 viven solo en ${APPS_LAYER_DIR}/.env (import-llm-token.sh, s3-requisites.sh env).
# Para relanzar en otro cluster/cuenta basta con cambiar CLUSTER_NAME, AWS_ACCOUNT_ID, AWS_REGION y EXTERNAL_DOMAIN
# (normalmente ya vienen de cluster.env) y volver a ejecutar los scripts.

# --- Identidad (por defecto, de cluster.env) ---
#export CLUSTER_NAME=igualdad-dgutierrez
#export AWS_ACCOUNT_ID=821111360971
#export AWS_REGION=eu-west-1
#export EXTERNAL_DOMAIN=${CLUSTER_NAME}.desa.int
#export KIT_AWS_PROFILE=cloud-provisioner          # perfil AWS para las llamadas (def: $CP_PROFILE o cloud-provisioner)

# --- Tenant y rutas ---
#export TENANT_NAME=dev                            # tenant especifico (distinto de keos)
#export APPS_LAYER_DIR=/tmp/apps-layer-igualdad-dgutierrez   # dir. de EJECUCION montado en /apps-layer (def: ${TMPDIR:-/tmp}/apps-layer-${CLUSTER_NAME}); efimero, 700, con secretos
#export KEOS_WORKSPACE_DIR=/stratio/e/igualdad     # workspace de keos (montado en /workspace; def: directorio padre del kit = raiz del workspace)
#export KUBECONFIG_SRC=/stratio/e/igualdad/1-aws-cluster/estado/kubeconfig-igualdad-dgutierrez   # origen del kube-config si falta (def: $KEOS_WORKSPACE_DIR/1-aws-cluster/estado/kubeconfig-$CLUSTER_NAME)

# --- Imagen de apps-layer-automation ---
#export APPS_LAYER_IMAGE=qa.int.stratio.com/stratio/apps-layer-automation:15.1-0.1.0-SNAPSHOT
#export APPS_LAYER_IMAGE_DIGEST=sha256:a745cac6f9a30b68e9e5ff5312c0b584ac78ffb2dc955ad3430661617de6d37a   # fija la imagen (el SNAPSHOT es mutable)
#                                                  # Alternativa inmutable: tags 15.1-0.1.0-M1 / 15.1-0.1.0-M2 (APPS_LAYER_IMAGE=qa.int.stratio.com/stratio/apps-layer-automation:15.1-0.1.0-M2). M2 incluye los cambios
#                                                  # de apps-layer-automation posteriores a 2026-10-29; no verificado que el Nexus de QA la sirva ni probada con este kit. El defecto sigue siendo SNAPSHOT.
#export UNIVERSE_VERSION=15.1.0                   # zip y universe-images.lst se descargan SIEMPRE frescos (fetch-universe.sh, lo invoca launch)
#export UNIVERSE_BRANCH=branch-15.1                # rama de Stratio/kubernetes-universe del .lst (def.: branch-<major>.<minor>); exige gh autenticado
#export CONNECTORS_LOADER_VERSION=2.2.0            # def. 2.2.0 (como Stratio/keos-fleet#220, probado solo en HDFS): se fija en el env de connectors-management y el hook IGNORA el .lst para el loader.
#                                                  # Vacia (CONNECTORS_LOADER_VERSION=) => no se fija y se usa el connectors-loader del .lst fresco (2.2.3 en branch-15.1). Verifica sscc-s3 con la que uses.
#export UNIVERSE_ZIP_URL=                          # override de http://qa.int.stratio.com/repository/paas/kubernetes-universe/descriptors/<zip>

# --- S3 en AWS (defaults derivados de CLUSTER_NAME y AWS_ACCOUNT_ID) ---
#export S3_BUCKET_NAME=${CLUSTER_NAME}-internal-${AWS_ACCOUNT_ID}
#export S3_USER_NAME=${CLUSTER_NAME}-s3
#export STACK_NAME=${CLUSTER_NAME}-requisites
#export S3_INIT_PATH=/${S3_BUCKET_NAME}            # INIT_PATH de connector-s3 (def. "/<S3_BUCKET_NAME>", verificado en vivo; no vacia y empieza por "/"). Necesaria por la errata
#                                                  # INTI_PATH de vars.env (branch-15.1-0.1): sin ella el agente crashea con "Missing environment variable: COMM_SERVICE_INIT_PATH".
#                                                  # NO usar "/" solo: el driver S3 lo rechaza (UnsupportedRootInitPath) y el kit aborta. Valido: /<bucket> o /<bucket>/<prefijo>.

# --- Bucket de backups de la plataforma Stratio (OPCIONAL; lo necesita la migracion a GitOps, apps-layer no lo usa) ---
# Desactivado por defecto: sin activarlo el stack ${STACK_NAME} no cambia en nada. Activarlo sobre un stack existente es una
# ACTUALIZACION que solo AÑADE recursos (bucket versionado+cifrado con Retain, usuario IAM, access key y secreto); nada existente se reemplaza.
# Secuencia: s3-requisites.sh plan -> apply -> env (escribe BACKUPS_S3_BUCKET_* en el .env, sin imprimirlas) -> backups-info (sin secretos).
#export ENABLE_BACKUPS_BUCKET=false                # true|false
#export BACKUPS_BUCKET_NAME=${CLUSTER_NAME}-backups-${AWS_ACCOUNT_ID}   # los nombres de bucket S3 son GLOBALES: la referencia (aws-clusters-automation)
#                                                  # usa ${CLUSTER_NAME}-backups, que sin sufijo de cuenta puede chocar con otra cuenta; este defecto lo evita.
#                                                  # No cambiarlo despues de crearlo (reemplazaria recursos: apply lo rechaza). Debe diferir de S3_BUCKET_NAME.
#export BACKUPS_USER_NAME=${CLUSTER_NAME}-backups  # usuario IAM y secreto de Secrets Manager (misma convencion que la referencia). Nunca cloud-provisioner/igualdad/perfil del kit.

# --- Backups de la plataforma con enviroment-ready (OPCIONAL; scripts/backups-env.sh solo escribe $APPS_LAYER_DIR/backups.env, no ejecuta nada) ---
# Bucket y NOMBRE del rol IRSA de Velero (los de cluster.env; no el bucket de ENABLE_BACKUPS_BUCKET). Sin comillas en backups.env: el script de apps-layer las exporta tal cual.
#export VELERO_BUCKET=${CLUSTER_NAME}-velero-${AWS_ACCOUNT_ID}
#export VELERO_ROLE=${CLUSTER_NAME}-velero
#export SC_POSTGRES=                               # StorageClass de los PVC de backup de postgres (def.: la StorageClass por defecto, keos)

# --- Caso de uso ---
#export ENVIRONMENT_SIZE=S                         # S | PIT | CUSTOM. S/PIT cargan apps/<app>/sizes/S|PIT DESPUES del env y en muchas apps lo PISAN. CUSTOM: overlay propio del kit (no existe sizes/CUSTOM upstream):
#                                                  # inyecta los recursos de templates/sizes-custom.env en el env: de cada app y ABORTA si a alguna le falta una variable (ver README, "ENVIRONMENT_SIZE=CUSTOM")
#export CUSTOM_SIZES_FILE=/ruta/absoluta/mis-sizes.env   # solo con CUSTOM: overlay propio (copia de templates/sizes-custom.env); SUSTITUYE al del kit, no se mezclan. Def.: templates/sizes-custom.env
#export VIRTUALIZER_CREATE_LOADBALANCER=false      # true crearia un Service LoadBalancer (ELB) en AWS
#export USE_TENANT_HOSTS=false                     # true: hosts genai|rocket|discovery|virtualizer|dlc.<tenant>.<dominio> (exigen DNS y certificado)
#export ENABLE_GENAI=true                          # true|false. true exige LLM_TOKEN; false quita genai-*, datamarket-agent y pit
#export KEOS_PROFILE=full                          # full (stack se-* + governance como eosdev) | minimal (gobierno de la PR 220)
#export LLM_PROVIDER=                              # opcionales, no secretos (def. de la app: openai / gpt-5.4-mini)
#export LLM_MODEL=

# --- Lanzamiento ---
#export KEOS_INSTALLER_EXTRA_ARGS="--net host"
#export NLB_IP=                                    # fija la IP para --add-host admin.<dominio> (si no, se resuelve del Service)
#export NLB_NAMESPACE=keos-ingress
#export NLB_SERVICE=ingress-nginx-controller
