{
    "descriptor": {
        "service": "rocket",
        "model": "defaults3",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "networking": {
                "rocketServerHost": "admin.igualdad-dgutierrez.desa.int"
            },
            "rocketVPath": "rocket",
            "serviceId": "rocket",
            "catalog": {
                "crossdataCatalogHiveDatabase": "virtualizer"
            },
            "namespaces": {
                "k8sNamespace": "dev-rocket"
            },
            "dependencies": {
                
                "opensearch": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Aopensearch1.dev-datastores",
                "genaiLitellm": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Agenai-litellm.dev-genai",
                "genaiApi": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Agenai-api.dev-genai",
                "postgresConnectionDB": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPolicies": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores",
                "virtualizerServer": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Avirtualizer.dev-apps"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-critical",
                "validatorworker": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-critical",
                "externalworker": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-critical",
                "catalogworker": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "debugworker": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "workflow": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "qualityrule": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "automl": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "mlproject": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "mlmodel": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "sparkexecutor": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            },
            "resources": {
                "CPUs": "0.5",
                "MEM": "1024",
                "defaultExecutorCoresMode": "Soft",
                "defaultDriverCoresMode": "Soft",
                "cpuResourceType": "Hard",
                "cpuLimit": 2,
                "memResourceType": "Guaranteed"
            },
            "genAI": {
                "genaiEnabled": true,
                "genaiLayerConf": {
                    "genaiLitellmChatEndpoint": "gpt-5.4-mini",
		    "sqlChainConf": {
                        "sqlChainOpensearchEnabled": true,
                        "sqlChainCustomIdEnabled": true
                    },
                    "genericSqlChainConf": {
                        "genericSqlChainCustomIdEnabled": true
                    },
                    "pysparkTransformChainConf": {
                        "pysparkTransformChainCustomIdEnabled": true
                    }
                }
            },
            "external": {
                "hdfs": {"s3GlobalCredentials": "s3-secret","hdfsConfigMapName": "s3-config","s3CredentialsByBucketEnabled": false,"hdfsRocketBasePath": "/data"}
            }
        },
        "settings": {
            "intelligenceJupyterHubUrl": {
                "intelligenceJupyterHubUrlEnabled": true,
                "url": "https://admin.igualdad-dgutierrez.desa.int/intelligence"
            },
            "localDirConfig": {
                "emptyDirInWorkersEnabled": true,
                "rocketLocalDir": "/tmp",
                "emptyDirInWorkersSizeLimit": "10Gi",
                "emptyDirInAssetsEnabled": true,
                "emptyDirInAssetsSizeLimit": "10Gi"
            },
	    "classpathConfiguration": {
                "crossdataNativeConnectorEnabled": true,
                "crossdataNativeEngineEnabled": true,
                "crossdataJdbcEnabled": true,
                "kafkaConnectorEnabled": false,
                "xmlConnectorEnabled": false,
                "xlsConnectorEnabled": false,
                "sftpConnectorEnabled": false,
                "tfrecordConnectorEnabled": false,
                "connectorS3Enabled": true,
                "connectorTikaEnabled": false,
                "connectorPdfEnabled": false,
	        "connectorOpenSearchEnabled": true,
                "rocketExtraJars": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-s3_2.12_1.5.1-49ce769.jar,",
                "sparkClasspathExtraJars": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-s3_2.12_1.5.1-49ce769.jar,"
            },
            "otherConfig": {
                "fileBrowserInternalMetadataFilesystemEnabled": true
            },
            "governanceIntegration": {
                "customPlannedQrsMethods": "com.stratio.connectors.ssccpostgresql.PostgreSQLDriverInternalTLS:com.stratio.connectors.ssccpostgresql.PostgreSQLQualityRulesAndLineage:getPlannedQRCreateTable,",
                "plannedQrEnable": true,
                "lineageEnable": true,
                "qualityScheduleEnable": true,
                "proactiveQrCacheOptimizedEnabled": false,
                "customLineageAndQrsMethods": "postgresql:com.stratio.connectors.ssccpostgresql.PostgreSQLQualityRulesAndLineage:getMetadataPath,",
                "crossdataCatalogGovernancePost": "https://dg-businessglossary-api.keos-core:60000/dictionary/user/catalog/v1/dataAsset",
                "customSparkLineageAndQrsMethods": "jdbc:com.stratio.connectors.ssccpostgresql.PostgreSQLQualityRulesAndLineage,",
                "customJdbcLineageAndQrsMethods": "org.postgresql.Driver:com.stratio.connectors.ssccpostgresql.PostgreSQLQualityRulesAndLineage:getMetadataPath,"
            }
        },
        "security": {
            "gosec": {
                "facadeConfiguration": {
                    "facadeCacheEnabled": true,
                    "facadeCacheTtl": "600 s"
                },
                "gosecPluginConfig": {
                    "crossdataDyplonAuthorizerMode": "resource",
                    "crossdataDyplonAuthorizer": "default",
                    "initServerDyplonXD": true
                },
                "dyplonConfiguration": {
                    "dyplonCacheEnabled": true,
                    "tagsDyplonCacheTtl": "10 min",
                    "domainsDyplonCacheTtl": "24 hour",
                    "servicesDyplonCacheTtl": "24 hour",
                    "usersDyplonCacheTtl": "24 hour",
                    "policiesDyplonCacheTtl": "24 hour",
                    "userTagsDyplonCacheTtl": "24 hour"
                },
                "spartaPluginCache": true
            }
        },
        "environment": {
            "workers": {
                "validatorService": {
                    "validatorCpuResourceType": "Hard",
                    "validatorCpuRequest": 0.2,
                    "validatorMemResourceType": "Guaranteed",
                    "validatorMemRequest": 1024,
                    "validatorCpuLimit": 2
                },
                "debugService": {
                    "debugRequestCpus": 0.2,
                    "debugCpuResourceType": "Hard",
                    "debugLimitCpus": 2,
                    "debugRequestMem": 1024,
                    "debugMemResourceType": "Guaranteed"
                },
                "catalogService": {
                    "catalogMemResourceType": "Guaranteed",
                    "catalogCpuResourceType": "Hard",
                    "catalogCpusLimit": 2,
                    "catalogMemRequest": 1024,
                    "catalogCpuRequest": 0.2
                },
                "externalService": {
                    "externalServiceCpusRequest": 0.1,
                    "externalCpuResourceType": "Hard",
                    "externalServiceCpusLimit": 2,
                    "externalServiceMemResourceType": "Guaranteed",
                    "externalServiceMemRequest": 1024
                }
            }
        }
    }
}
