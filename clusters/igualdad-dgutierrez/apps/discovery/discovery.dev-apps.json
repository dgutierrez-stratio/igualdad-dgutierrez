{
    "descriptor": {
        "service": "discovery",
        "model": "default",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "discovery",
            "networking": {
                "haproxyhost": "admin.igualdad-dgutierrez.desa.int",
                "haproxypath": "/discovery.dev-apps"
            },
            "namespaces": {
                "k8sNamespace": "dev-apps"
            },
            "dependencies": {
                "postgresConnectionDB": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPolicies": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            },
            "userAuthentication": {
                "ssoOptions": {
                    "adminGroup": "dev-stratio-owners",
                    "useGroupWhitelist": false,
                    "groupWhitelist": "dev-discovery"
                }
            },
            "resources": {
                "CPUs": "0.5",
                "MEM": "2048",
                "cpuLimit": "2",
                "cpuResourceType": "Hard",
                "memResourceType": "Guaranteed"
            }
        }
    }
}
