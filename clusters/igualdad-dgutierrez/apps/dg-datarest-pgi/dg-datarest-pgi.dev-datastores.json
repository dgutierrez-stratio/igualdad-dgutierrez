{
    "descriptor": {
        "service": "bdl",
        "model": "datarest-pginternal",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "datastore": {
                "postgresqlInternal": {
                    "datastoreDatabase": "data",
                    "datastoreSchemas": "*",
                    "datastoreHostPath": "${postgresPolicies.host}.${postgresPolicies.namespace}",
                    "datastoreSchemasInternal": "\\[${general.datastore.postgresqlInternal.datastoreSchemas}\\]",
                    "datastoreConnectionParams": "?prepareThreshold=0",
                    "datastoreHost": "${postgresDiscovery.host}.${postgresDiscovery.namespace}"
                },
                "datastoreDriverUrl": "",
                "datastoreTableTypesToBeDiscovered": "TABLE",
                "datastoreType": "PostgreSQL (internal)",
                "datastoreFilterUnsupportedTableTypes": true,
                "datastoreDriverUrlFetchEnabled": false
            },
            "name": "${serviceId}",
            "host": "fieldRef:status.podIP:v1",
            "port_13421": "8001",
            "resources": {
                "GPUs": 0,
                "MEM": 2048,
                "INSTANCES": 1,
                "podCpuLimit": 1,
                "CPUs": 0.2,
                "podMemoryLimit": 2048,
                "DISK": 0
            },
            "port_13420": "8000",
            "dataRestServerHost": "admin.${external_domain}",
            "serviceId": "dg-datarest-pgi",
            "dockerHost": "${dataRestServerHost}",
            "executePrerequisites": true,
            "identity": {
                "approlename": "${Application.domain}-${Application.name}"
            },
            "dataRestServerNetwork": "${tenantId}",
            "countQueryElementsEnabled": true,
            "oauth2ProxyHost": "oauth2-proxy.keos-auth.svc.${eos.internalDomain}",
            "serverServletStratioPrefixContextPath": "/${tenantName}",
            "impersonate": true,
            "tenantName": "${serviceId}.${k8sNamespace}",
            "namespaces": {
                "k8sNamespace": "dev-datastores"
            },
            "dependencies": {
                "postgresDiscovery": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPolicies": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            }
        }
    }
}