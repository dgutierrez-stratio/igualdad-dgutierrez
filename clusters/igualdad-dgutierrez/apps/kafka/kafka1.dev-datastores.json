{
    "descriptor": {
        "service": "Kafka",
        "model": "kraft",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "kafka1",
            "namespaces": {
                "k8sNamespace": "dev-datastores"
            }
        },
        "specification": {
            "nodeGroups": [
                {
                    "roles": [
                        "CONTROLLER"
                    ],	
                    "resources": {
                        "limits": {
                            "cpu": 4,
                            "memory": "3072M"
                        },
                        "requests": {
                            "cpu": 0.2,
                            "memory": "1024M"
                        }
                    }
                },
                {
                    "roles": [
                        "BROKER"
                    ],
                    "resources": {
                        "limits": {
                            "cpu": 4,
                            "memory": "3072M"
                        },
                        "requests": {
                            "cpu": 0.2,
                            "memory": "1024M"
                        }
                    }
                }
            ]
        }
    }
}
