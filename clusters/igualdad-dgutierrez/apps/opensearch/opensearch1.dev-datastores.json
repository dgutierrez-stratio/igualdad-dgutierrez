{
    "descriptor": {
        "service": "Opensearch",
        "model": "default",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "opensearch1",
            "namespaces": {
                "k8sNamespace": "dev-datastores"
            }
        },
        "specification": {
            "security": {
                "serviceAccount": {
                    "name": "opensearch1"
                }
            },
            "config": {
                "plugins": []
            },
            "nodeGroups": [
                {
                    "resources": {
                        "limits": {
                            "cpu": 1,
                            "memory": "2048M"
                        },
                        "requests": {
                            "cpu": 0.1,
                            "memory": "2048M"
                        }
                    }
                }
            ]
        }
    },
    "applicationId": "opensearch1.dev-datastores"
}
