{
    "descriptor": {
        "service": "PgBouncer",
        "model": "default",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "pool-psql",
            "namespaces": {
                "k8sNamespace": "dev-datastores"
            },
            "dependencies": {
                "postgresql": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores"
            }
        },
        "specification": {
            "postgresql": {
                "connectionMode": "PRIMARY"
            },
            "instances": 2,
            "config": {
                "client_idle_timeout": "120",
                "default_pool_size": "50",
                "pool_mode": "transaction"
            },
            "constraints": {
                "tolerations": [
                    
                ],
                "affinity": {
                    "nodeAffinity": {}
                }
            },
            "resources": {
                "limits": {
                    "cpu": "1",
                    "memory": "1024M"
                },
                "requests": {
                    "cpu": "0.1",
                    "memory": "1024M"
                }
            }
        }
    }
}
