{
    "descriptor": {
        "service": "connectors-management",
        "model": "connectors-management-service-default",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "connectors-management",
            "namespaces": {
                "k8sNamespace": "dev-apps"
            },
            "connectorsCustomStratioCredentialsDefinition": "connectors-secret",
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=default-nonpreempting"
            },
            "resources": {
                "cpuLimit": 2,
                "CPUs": 0.25,
                "DISK": 2048,
                "INSTANCES": 1,
                "MEM": 1536,
                "memLimit": 1536
            }
        },
        "networking": {
            "exposeIngress": false
        }
    }
}
