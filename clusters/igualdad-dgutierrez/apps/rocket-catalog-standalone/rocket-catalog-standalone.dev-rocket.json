{
    "descriptor": {
        "service": "rocket",
        "model": "catalog",
        "version": "15.1.0"
    },
    "deployment": {
        "general": {
            "serviceId": "rocket-catalog-standalone",
            "rocketVPath": "rocket-catalog-standalone",
            "networking": {
                "rocketServerHost": "admin.igualdad-dgutierrez.desa.int"
            },
            "resources": {
                "CPUs": 0.5,
                "MEM": 3072,
                "cpuResourceType": "Hard",
                "cpuLimit": 2,
                "memResourceType": "Guaranteed"
            },
            "catalog": {
                "crossdataCatalogHiveDatabase": "virtualizer",
                "crossdataCatalogJdbcUri": "jdbc:crossdata://Server=virtualizer.dev-apps:13422;MAX_CONTENT_LENGTH=1024m;LogLevel=INFO;LogPath=/tmp/crossdata-jdbc-logs;LogFileSize=20MB;LogFileCount=1"
            },
            "genAI": {
                "genaiEnabled": false,
                "genaiLayerConf": {
                    "genaiLitellmChatEndpoint": "gpt-5.4-mini",
                    "sqlChainConf": {
                        "sqlChainOpensearchEnabled": false
                    }
                }
            },
            "governanceRegistration": {
                "enableGovernanceRegistration": true
            },
            "namespaces": {
                "k8sNamespace": "dev-rocket"
            },
            "dependencies": {
                
                
                "postgresConnectionDB": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPolicies": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores",
                "virtualizerServer": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Avirtualizer.dev-apps"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            }
        },
        "settings": {
            "classpathConfiguration": {
                "rocketExtraJars": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,",
                "sparkClasspathExtraJars": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,"
            }
        },
        "security": {
            "gosec": {
                "facadeConfiguration" : {
                    "facadeCacheEnabled": false
                },
                "dyplonConfiguration": {
                    "dyplonCacheEnabled": false
                },
                "spartaPluginCache": false
            }
        }
    }
}
