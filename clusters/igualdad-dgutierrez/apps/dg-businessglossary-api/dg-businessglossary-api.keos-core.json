{
    "descriptor": {
        "service": "governance",
        "model": "api-default",
        "version": "15.1.0"
    },
    "deployment": {
        "settings": {
            "swaggerEnabled": true
        },
        "general": {
            "resources": {
                "MEM": 2048,
                "podCpuLimit": 2,
                "CPUs": 0.1,
                "podMemoryLimit": 2048
            },
            "serviceId": "dg-businessglossary-api",
            "serviceIdName": "dg-businessglossary-api",
            "governanceServerHost": "${admin_fqdn}",
            "namespaces": {
                "k8sNamespace": "keos-core"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-critical"
            }
        }
    }
}
