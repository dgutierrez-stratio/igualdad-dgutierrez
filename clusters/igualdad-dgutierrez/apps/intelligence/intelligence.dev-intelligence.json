{
    "descriptor": {
        "service": "intelligence",
        "model": "default",
        "version": "15.1.0"
    },
    "deployment": {
        "settings": {
            "AnalyticSettings": {
                "rocket-integration": {
                    "useRocketAuth": true,
                    "useRocket": true,
                    "rocketService": "https://rocket.dev-rocket:7777"
                },
		"spark": {
                    "sparkUser": "root"
                },
                "extraJarsConfiguration": {
                    "sparkClasspathExtraJars": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,"
                }
            },
            "multiuserSettings": {
                "enableMetrics": true
            }
        },
        "general": {
            "jupyterHubAuthenticator": {
                "jupyterHubAdminGroups": "[dev-stratio-owners]",
                "configAdminUsers": "[admin,dev-user]"
            },
            "jupyterHubIdleCuller": {
                "jupyterhubIdleCullerEnabled": true,
                "jupyterhubIdleCullerTimeout": 7200
            },
            "genAI": {
                "genaiEnabled": true,
                "genaiLayerConf": {
                    "genaiLitellmChatEndpoint": "gpt-5.4-mini"
                }
            },
            "genaiSettings": {
                "genaiLayerConf": {
                    "genaiAPIIntegration": {
                        "genaiChainsConf": {
                            "genaiChainsTranslateLitellmModel": "gpt-5.4-mini",
                            "sqlChainConf": {
                                "sqlChainOpensearchEnabled": true
                            }
                        }
                    },
                    "litellmIntegration": {
                        "litellmDefaultModelGroup": "gpt-5.4-mini"
                    }
                },
                "genaiEnabled": true
            },
            "persistentVolumes": {
                "userRelatedVolumesConf": {
                    "storageClass": "keos"
                },
                "userRelatedVolumesEnable": false,
                "usersSharedFolderEnable": false,
                "usersSharedFolderConf": {
                    "sharedFolderName": "shared_folder",
                    "sharedFolderPVCName": "keos"
                }
            },
            "intelligenceInstanceName": "",
            "resources": {
                "memResourceType": "Soft",
                "cpuResourceType": "Hard",
                "MEM": 512,
                "CPUs": 0.1,
                "cpuLimit": 1
            },
            "HDFSConfiguration": {
                "HDFSConfigurationSource": "no-hdfs"
            },
            "postgres": {
                "jupyterhubDbName": "intelligence",
                "postgresGosecService": "psql.dev-datastores",
                "postgresDbUrl": "pool-psql.dev-datastores:5432",
                "pgClusterNamespace": "dev-datastores",
                "pgClusterName": "psql"
            },
            "networking": {
                "multiuserServerHost": "admin.igualdad-dgutierrez.desa.int",
                "multiuserServerBasePath": "/intelligence"
            },
            "tenant": "dev",
            "serviceId": "intelligence",
            "namespace": "dev-intelligence",
            "serviceName": "intelligence",
            "namespaces": {
                "k8sNamespace": "dev-intelligence"
            },
            "dependencies": {
                
		"opensearch": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Aopensearch1.dev-datastores",
                "postgresUrl": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresHost": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores",
                "virtualizerServer": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Avirtualizer.dev-apps",
                "genaiApi": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Agenai-api.dev-genai",
                "genaiLiteLLM": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Agenai-litellm.dev-genai"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "analytic": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "sparkexecutor": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            }
        },
        "security": {
            "configAPI": {
                "configApiSecurity": true,
                "apiAdminCNs": "intelligence.dev-intelligence"
            }
        },
        "K8S_ANALYTIC_PRIORITY_CLASS_NAME": "applications-normal",
        "K8S_ANALYTIC_EXECUTORS_PRIORITY_CLASS_NAME": "applications-normal"
    }
}
