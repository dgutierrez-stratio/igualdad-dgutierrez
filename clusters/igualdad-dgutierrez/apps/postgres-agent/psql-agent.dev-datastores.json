{
   "descriptor":{
      "service":"pg-gosec-agent",
      "model":"default",
      "version":"15.1.0"
   },
   "deployment":{
      "general":{
         "serviceId":"psql-agent",
         "namespaces":{
            "k8sNamespace":"dev-datastores"
         },
         "dependencies":{
            "postgresql":"https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores"
         },
         "priorities":{
            "application":"https://cct-paas-services:8443/v1/priority-classes/metadata?q=default-nonpreempting"
         },
         "resources": {
                "memLimit": "1024",
                "CPUs": "0.5",
                "MEM": "1024",
                "cpuLimit": "2"
            }
      },
      "environment": {
          "domainsConfig": {
              "domainsEnable": true
          }
      }
   }
}

