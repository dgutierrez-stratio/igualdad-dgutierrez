{
    "descriptor": {
        "service": "virtualizer",
        "model": "default",
        "version": "15.1.0"
    },
    "deployment": {
        "settings": {
            "virtualizerSparkFallbackEnabled": true,
            "catalog": {
                "virtualizerCoreCatalogCacheOnDemandTtl": "1 minute",
		"virtualizerCoreCatalogCacheOnDemand": false
            },
            "enablePrometheusSpark": {
                "virtualizerPrometheusSparkDriverSources": "jvm,BlockManager,System,XDMetrics",
                "virtualizerPrometheusSparkJmxImporter": false,
                "virtualizerPrometheusSparkExecutorSources": "jvm,BlockManager,System"
            },
            "enableQueryStats": {
                "virtualizerServerQueryStatsMemoryUsagePercent": "1",
                "virtualizerServerMetricsQueryStatsEnabled": true
            }
        },
        "general": {
            "monitoring": {
                "monitoringPostgresqlDBScheme": "virtualizer",
                "monitoringEnabled": true,
                "executePrerequisitesPgPolicyMonitoring": true
            },
            "serviceId": "virtualizer",
            "namespaces": {
                "k8sNamespace": "dev-apps"
            },
            "dependencies": {
                
                "postgresConnectionDB": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPolicies": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores",
                "postgresConnectionDBMonitoring": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apool-psql.dev-datastores&host=pool-psql",
                "postgresPoliciesMonitoring": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Apsql.dev-datastores"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal",
                "sparkexecutor": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            },
            "gcatalog": {
                "catalogPostgresqlDB": "virtualizer"
            },
            "ghadoop": {
                "defaultStorageSelector": "Amazon S3",
                "virtualizerDefaultProvider": "parquet",
                "virtualizerStoragePath": "/data",
                "s3ManuallyConfig": {"s3ManuallyConfigEnabled": true,"s3ManuallyConfigFsDefaultFs": "s3a://igualdad-dgutierrez-internal-699773898240"}
            },
	    "virtualizerExposition": {
                "createLoadBalancer": false
            },
            "HDFSPolicy": {
                "executePrerequisitesHdfsPolicy": false
            },
            "custom": [
                {
                    "key": "CONF_KV_spark_sql_filesourceTableRelationCacheSize",
                    "value": "100"
                },
                {
                    "key": "CONF_KV_spark_cleaner_periodicGC_interval",
                    "value": "5"
                }
            ]
        },
        "security": {
            "virtualizerHashHiddenColumns": false,
            "gosec": {
                "xdPluginDyplonAuthorizerMode": "all",
                "facadeConfiguration": {
                    "facadeCacheEnabled": false,
                    "facadeAuthMode": "local"
                },
                "dyplonConfiguration": {
                    "dyplonCacheEnabled": false
                },
                "serverConfiguration": {
                    "ServerCacheEnabled": false
                }
            }
        },
        "processing": {
            "spark": {
                "sparkDynamicAllocation": {
                    "dynamicAllocationEnabled": true
                }
            }
        },
        "connectors": {
            "externalHdfs": {
                "externalHdfsEnabled": false
            },
            "connectorS3": {
                "connectorS3Enabled": true,
                "envS3GlobalCredentialsSecretEnabled": true,
                "envS3GlobalCredentialsSecret": "s3-secret",
                "envS3CredentialsByBucketSecretEnabled": false,
                "envS3StorageArtifactDefault": false,
                "envS3StorageArtifactURL": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-s3_2.12_1.5.1-49ce769.jar"
            },
            "connectorAzureGen2": {
                "connectorAzureGen2Enabled": false
            },
            "connectorGCS": {
                "connectorGCSEnabled": false
            },
            "connectorJdbc": {
                "connectorJdbcEnabled": true,
                "connectorJdbcDrivers": "http://connectors-management.dev-apps/v1/api/artifact/Connector_sscc-postgresql_2.12_1.6.1-a8eef0c.jar,"
            }
        },
        "CONF_KV_spark_sql_filesourceTableRelationCacheSize": "100",
        "CONF_KV_spark_cleaner_periodicGC_interval": "5",
        "SPARK_DEFAULTS_AGG": "spark.kubernetes.executor.annotation.cluster-autoscaler.kubernetes.io/safe-to-evict=true"
    }
}
