{
    "descriptor": {
        "service": "governance",
        "model": "agent-scheduler-default",
        "version": "15.1.0"
    },
    "deployment": {
        "settings": {
            "governanceApi": {
                "clientUserName": "dg-scheduler-agent"
            },
            "SearcherAdvancedConfig": {
                "domainConfig": {
                    "DataMarketDomain": {
                        "autocompletePhoneticEnabled": true
                    },
                    "GovernanceDomain": {
                        "searchPhoneticEnabled": true,
                        "autocompletePhoneticEnabled": true
                    }
                }
            }
        },
        "general": {
            "processesConfig": {
                "schedulerConfiguration": {
                    "dataMarketUrl": "https://dg-datamarket-api.keos-core:8080/dg-datamarket-api",
                    "dataMarketEnabled": true,
                    "managerIndexer": "https://se-indexer.keos-core:8082",
                    "managerUrl": "https://se-manager.keos-core:8080",
                    "dataMarketHealthCheckUrl": "http://dg-datamarket-api.keos-core:8091/actuator/health"
                }
            },
            "resources": {
                "MEM": 768,
                "podCpuLimit": 1.5,
                "CPUs": 0.1,
                "podMemoryLimit": 768
            },
            "serviceId": "dg-scheduler-agent",
            "namespaces": {
                "k8sNamespace": "keos-core"
            },
            "dependencies": {
                "dictionaryApi": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Adg-businessglossary-api.keos-core",
                "manager": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Ase-manager.keos-core",
                "indexer": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Ase-indexer.keos-core",
                "datamarket": "https://cct-applications-query:8443/v1/dependencies/metadata?q=application_id%3Adg-datamarket-api.keos-core"
            },
            "priorities": {
                "application": "https://cct-paas-services:8443/v1/priority-classes/metadata?q=applications-normal"
            }
        }
    }
}
