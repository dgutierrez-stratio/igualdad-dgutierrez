# Variables de un clúster legacy (cloud-provisioner, gitops_enabled: false).
# Lo genera `scripts/init-cluster.sh --account <cuenta> --name <clúster>` en ./clusters/<clúster>/cluster.env.
# Los valores de abajo son ficticios (ejemplo). Se carga con:  source ./cluster.env
# No contiene secretos: las claves del usuario IAM se leen del perfil $CP_PROFILE al renderizar el
# descriptor (render-cluster.sh) y VAULT_PASSWORD se exporta a mano en el terminal.
# Todo lo que NO es "entrada" se deriva de CLUSTER_NAME / AWS_ACCOUNT_ID.

# --- ENTRADAS (las dos obligatorias) ---
export CLUSTER_NAME=igualdad-dgutierrez
export AWS_ACCOUNT_ID=699773898240

# --- Cuenta y región AWS ---
export AWS_REGION=eu-west-1
# Perfil con acceso de administrador a la cuenta (rol asumido). Solo crea el usuario IAM `cloud-provisioner`.
# Lo descubre init-cluster.sh (find-admin-profile.sh); si hay 0 o varios candidatos se pregunta.
export ADMIN_PROFILE=igualdad
# Perfil del usuario IAM `cloud-provisioner` (lo crea `provision.sh iam-user`). Es el AWS_PROFILE de cloud-provisioner.
export CP_PROFILE=cloud-provisioner-699773898240

# --- Dominio (override posible: EXTERNAL_DOMAIN=otro.dominio) ---
export DNS_PARENT_DOMAIN=desa.int
export EXTERNAL_DOMAIN="${CLUSTER_NAME}.${DNS_PARENT_DOMAIN}"

# --- Registry y versiones ---
export ECR_REGISTRY=717279725338.dkr.ecr.eu-west-1.amazonaws.com
export K8S_VERSION=v1.35.0
export CLUSTER_OPERATOR_VERSION=0.7.4
export ECR_POLICY_NAME=ecr-pull-through-cache-machinepool
export ECR_POLICY_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:policy/${ECR_POLICY_NAME}"

# --- Nodegroup ---
export NODEGROUP_NAME=desa-eks-1
export NODE_SIZE=m6a.4xlarge
export NODE_QTY=3
export NODE_MIN=3
export NODE_MAX=6

# --- Red (create-test-vpc.sh) ---
export VPC_CIDR=10.0.0.0/16
export VPC_AZS=3                # la plantilla del descriptor espera exactamente 3
export VPC_NAT_MODE=single      # per-az | single | none

# --- cloud-provisioner (https://github.com/Stratio/kind) ---
# La versión del binario es también el tag de la imagen de arranque que se descarga del ECR
# ($ECR_REGISTRY/stratio/cloud-provisioner:<versión>).
export CLOUD_PROVISIONER_VERSION=0.9.8
# Ruta absoluta del binario (compilar desde el tag; ver references/steps.md, paso 0). init-cluster.sh intenta localizarlo.
export CLOUD_PROVISIONER_BIN=/home/dgutierrez/src/cloud-provisioner-0.9.8/bin/cloud-provisioner

# --- keos-installer (pasos 7-13) ---
export KEOS_INSTALLER_VERSION=1.4.2
export KEOS_INSTALLER_IMAGE=qa.int.stratio.com/stratio/keos-installer:${KEOS_INSTALLER_VERSION}
export KEOS_HELM_PATH=helm-15.1            # chart repo de keos-installer (lo usan el descriptor de cloud-provisioner y keos.yaml; si falta, helm-15.1)
export VELERO_BUCKET=${CLUSTER_NAME}-velero-${AWS_ACCOUNT_ID}   # los nombres de bucket S3 son globales
export VELERO_ROLE=${CLUSTER_NAME}-velero
export EFS_SC_NAME=efs-${CLUSTER_NAME}     # todo en minúsculas
export INGRESS_EXTERNAL_LB=true            # false = solo LB interno (variante cerrada, sin LB público)
export INGRESS_EXTERNAL_CIDRS='["0.0.0.0/0"]'   # lista JSON; ¡abierto a todo por defecto! limitar a los CIDR reales
# Policy IAM de ejemplo del driver EFS CSI (se descarga de master sin versión fija: revisar antes de aplicar).
export EFS_CSI_POLICY_URL=https://raw.githubusercontent.com/kubernetes-sigs/aws-efs-csi-driver/master/docs/iam-policy-example.json

# --- Opcionales post `keos install` (paso 13b; TODOS desactivados por defecto; descomentar para activar) ---
# keos install solo despliega la base: monitorización, Velero, backups programados, central logging y falco NO vienen con él (el cliente los
# tiene). `scripts/render-postinstall.sh` imprime, según estos flags, los comandos a lanzar DENTRO del contenedor keos-installer (no ejecuta nada).
#export ENABLE_BACKUP_VELERO=false      # keos.yaml: keos.backup.storage_class=${EFS_SC_NAME} (sin ella el PVC RWX de `keos backup create vault` queda Pending en EBS);
                                        #   override_vars: velero_enable_snapshot_volumes: true; y override_charts_values/keos-backup-velero.yaml con
                                        #   credentials.useSecret: false (requisito con IRSA en keos-installer 1.4.2: sin él la BSL queda Unavailable). Bloque 13b: keos backup velero
#export KEOS_ENABLE_CLAMAV=false        # keos.yaml: keos.security.clamav.enabled: true (en 1.4.2 lo despliega `keos install`)
#export ENABLE_MONITORING=false         # bloque 13b: keos monitoring (+ parche PLT-5162 del pushgateway, que se pierde si se relanza keos monitoring)
#export ENABLE_CENTRAL_LOGGING=false    # bloque 13b: keos central-logging (fluentd + OpenSearch)
#export ENABLE_FALCO=false              # keos.yaml lleva SIEMPRE falco.enabled: false (el precheck de `keos install` falla con true); el flag solo añade al
                                        #   bloque 13b activarlo (keos.yaml + CR keos) y `keos falco`. Salida a OpenSearch: requiere ENABLE_CENTRAL_LOGGING
#export ENABLE_BACKUP_SCHEDULE=false    # bloque 13b: keos backup schedule vault idp (00:00 y 00:05, 7 días, sin control-plane); requiere keos backup velero

# --- apps-layer-automation (paso 14, DESPUÉS de keos install; las lee el 2-apps-layer-kit vía scripts/apps-layer.sh) ---
# Todas opcionales (defaults entre paréntesis). Sin secretos: las claves S3 y LLM_TOKEN solo viven en ${TMPDIR:-/tmp}/apps-layer-<cluster>/.env
# Antes de empezar: unset APPS_LAYER_DIR (una variable exportada vieja pisa el directorio efímero).
#export TENANT_NAME=dev                      # tenant de trabajo (dev; no puede ser keos)
#export ENABLE_GENAI=true                    # true exige LLM_TOKEN; false quita genai-*, datamarket-agent y pit
#export KEOS_PROFILE=full                    # full | minimal
#export ENVIRONMENT_SIZE=S                   # S, PIT o CUSTOM (CUSTOM: ver 2-apps-layer-kit/README.md)
#export UNIVERSE_VERSION=15.1.0              # zip y universe-images.lst se descargan SIEMPRE frescos antes de cada lanzamiento
#export UNIVERSE_BRANCH=branch-15.1          # rama de Stratio/kubernetes-universe del .lst (exige gh autenticado)
#export APPS_LAYER_IMAGE=qa.int.stratio.com/stratio/apps-layer-automation:15.1-0.1.0-SNAPSHOT
#export NLB_IP=                              # solo si el NLB no se resuelve desde esta estación (--add-host)

# --- Bucket de backups de la plataforma Stratio (OPCIONAL, para migrar a GitOps; apps-layer NO lo usa; defecto: desactivado) ---
# Es un recurso más del stack <cluster>-requisites (fase apps-layer). Activarlo sobre un stack ya creado es una ACTUALIZACIÓN que solo AÑADE
# bucket (versionado, cifrado, Retain) + usuario IAM + access key + secreto; no reemplaza nada. Secuencia: `apps-layer.sh s3 plan` -> `s3 apply --apply`
# -> `s3 env` (BACKUPS_S3_BUCKET_* al .env, 600, sin imprimirlas) -> `s3 backups-info` (sin secretos). Los nombres S3 son globales (sufijo de cuenta).
#export ENABLE_BACKUPS_BUCKET=false                         # true|false
#export BACKUPS_BUCKET_NAME=${CLUSTER_NAME}-backups-${AWS_ACCOUNT_ID}
#export BACKUPS_USER_NAME=${CLUSTER_NAME}-backups           # nunca cloud-provisioner ni igualdad; el teardown lo CONSERVA salvo --delete-s3-requisites --delete-backups
export CP_HELM_PATH=helm
export ENABLE_BACKUP_VELERO=true
export KEOS_ENABLE_CLAMAV=true
export ENABLE_FALCO=true
export ENABLE_BACKUPS_BUCKET=true
